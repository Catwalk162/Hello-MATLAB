sigma = randn(1);
mi = round(10*randn(1));
x = 0:0.1:10;
% Gaussiana
nun = -(x - mi).^2;
den = 2*sigma^2;
a = 1/(sqrt(2*pi*sigma^2));
y = a * exp(nun/2*sigma^2);
%% Plots
figure(1), clf
plot(x,y, 'linew',2);
xlabel('x');
ylabel('y');
title('y vs x');
grid minor;
