iteracoes = double(input('Digite um número inteiro de iterações: '));
vpi = 0;
mempi = zeros(iteracoes, 1);
erro = zeros(iteracoes,1);
for i = 0:iteracoes
    vpi =  vpi + 4 * ((-1)^i / (2*i + 1));
    erro(i + 1, 1) = abs(vpi - pi);
end

disp(vpi);

figure(1);
plot(linspace(1, iteracoes, iteracoes + 1), erro, 'linew', 2);
title('Erro x iterações');
xlabel('Iteração');
ylabel('Erro');
grid minor;
